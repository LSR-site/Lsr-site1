# Copie ce fichier en .env pour lancer en local (npm start).
# Sur Vercel, mets les mêmes variables dans Settings > Environment Variables.

# Supabase > Project Settings > API Keys
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# Une longue phrase au hasard (sert à signer les connexions staff)
SESSION_SECRET=change-moi-par-une-longue-phrase-au-hasard

# Mots de passe staff (un par grade)
STAFF_PASSWORD_FONDATEUR=
STAFF_PASSWORD_FONDATRICE=
STAFF_PASSWORD_ADMIN=
STAFF_PASSWORD_MODO=
STAFF_PASSWORD_HELPER=

# Bot Discord des tickets
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1392481839762899057
# Facultatif : ID de la catégorie Discord des tickets et du rôle staff
DISCORD_TICKET_CATEGORY_ID=
DISCORD_TICKET_STAFF_ROLE_ID=
